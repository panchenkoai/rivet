 fn cdc_ok_line(report: &load::CdcLoadReport) -> String {
+    let leg = report.baseline.as_ref().map_or(String::new(), |b| {
+        format!(
+            "baseline: {} row(s) landed in `{}`; ",
+            b.rows_loaded, b.target_table
+        )
+    });
+    format!("{leg}{}", cdc_stream_line(report))
+}
