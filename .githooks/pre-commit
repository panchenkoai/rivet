#!/usr/bin/env bash
# Pre-commit gate — mirrors the CI fmt + clippy + audit steps
# (.github/workflows/ci.yml) so a commit can't introduce drift CI would reject.
#
# Enable once per clone (these hooks are version-controlled under .githooks/,
# not auto-installed):
#
#     git config core.hooksPath .githooks
#
# Bypass in an emergency with `git commit --no-verify` (CI still enforces it).
set -euo pipefail

# STEP 0, before anything trusts cargo: drop a `cargo package` snapshot.
#
# `cargo package` / `cargo publish` copy the crate to
# `target/package/<name>-<version>/` and BUILD that copy to verify it. With no
# `--target-dir` the verify build shares this `target/`, so the fingerprints it
# leaves record the crate's sources as `target/package/<name>-<version>/src/**`
# — a frozen snapshot. Every later `cargo build` here then compares the SNAPSHOT
# mtimes, finds nothing newer, prints `Fresh` and silently skips your edits.
# Cargo says so itself once the snapshot is gone: "Dirty …: the file
# `target/package/…/src/types/target.rs` is missing".
#
# It cost half a session: `cargo build` reported success while producing a
# binary without the changes, so every local check was green against code that
# was not there — including a deliberate type error appended to `lib.rs`.
#
# This runs FIRST on purpose. The hook's own fmt/clippy/build steps would
# otherwise be lied to by the same staleness, and a check cannot detect what it
# is blind to. Removing the directory is safe and cheap: it is pure build
# scratch, regenerated by the next `cargo package`.
if [ -d target/package ]; then
    echo "pre-commit: dropping target/package (a cargo-package snapshot freezes fingerprints)"
    rm -rf target/package
fi

echo "pre-commit: cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "pre-commit: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

# Keep ALL code-derived docs in sync with the Config/Cli types + crate version.
# Two CI gates enforce this and both derive from the binary (schemars + clap):
#   - schema_drift  → schemas/rivet.schema.json
#   - docs-as-code  → docs/reference/{config,cli}-reference.md + expanded includes
# A version bump or a Config/CLI change would otherwise only surface as a CI
# failure. Regenerate + stage them here so every commit carries current docs.
echo "pre-commit: regenerate code-derived docs (schema + reference)"
cargo build --quiet --bin rivet
./target/debug/rivet schema config > schemas/rivet.schema.json
cp schemas/rivet.schema.json schemas/latest/rivet.schema.json
RIVET=./target/debug/rivet python3 -m dev.pytools.docgen
git add -u schemas docs   # stage the regenerated (tracked) schema + reference docs

# Dependency vulnerability gate — mirrors the CI `audit` job and honors the
# accepted-advisory list in `.cargo/audit.toml`. Hard gate when `cargo-audit`
# is installed; otherwise prints an install hint and continues (CI still
# enforces it) so the hook stays usable for contributors without the tool.
echo "pre-commit: cargo audit"
if command -v cargo-audit >/dev/null 2>&1; then
    cargo audit
else
    echo "pre-commit: cargo-audit not installed — skipping locally (CI still enforces it)."
    echo "           install once with: cargo install cargo-audit --locked"
fi

# Best-effort knowledge-graph refresh — no-op when the tool isn't installed,
# so this hook stays portable for contributors who don't use code-review-graph.
if command -v code-review-graph >/dev/null 2>&1; then
    code-review-graph update || true
fi

echo "pre-commit: ok"
